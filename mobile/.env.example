# Copy to mobile/.env for local development (Expo reads EXPO_PUBLIC_* at build time).
# Your phone can't reach "localhost" on your computer: use your computer's LAN
# address, e.g. http://192.168.1.20:3001 (server/ must be running, same Wi-Fi).
EXPO_PUBLIC_API_URL=http://192.168.1.20:3001
# EXPO_PUBLIC_SENTRY_DSN=
