# Copy to server/.env for local development. Every value here is safe to
# commit: it points at the Docker database and sends no real email.

# local | staging | production — local refuses to touch a remote database
APP_ENV=local
PORT=3001

# The Docker Postgres (npm run db:up). Never paste a Supabase URL here; if you
# truly must, ALLOW_REMOTE_DB=true is required as well.
DATABASE_URL=postgres://chronically:chronically@localhost:5433/chronically

JWT_SECRET=local-dev-secret-change-nothing-real
FRONTEND_URL=http://localhost:5173

# Leave unset locally: emails (verification, reset links) print to this
# terminal instead of being sent. Required in production.
# RESEND_API_KEY=

# Background jobs (push reminders, weather) are off locally. Turn them on only
# to work on them — with the local database they can only reach test accounts.
# ENABLE_JOBS=true

# ── staging / production only (set in Render, never in a file) ──────────────
# SENTRY_DSN=
# DB_CA_CERT=                       Supabase CA certificate, for verified SSL
# CORS_ORIGINS=                     extra web origins, comma-separated
# DISABLE_NOTIFICATION_SCHEDULER=true
# DISABLE_WEATHER_BACKFILL=true
